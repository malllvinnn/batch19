classDiagram
    direction TB

    %% Dependency
    ICard ..> CardSuit : uses
    ICard ..> CardRank : uses
    IPlayer ..> PlayerStatus : uses
    IPot ..> IPlayer : uses
    GameController ..> ICard : uses
    GameController ..> BettingAction : uses
    GameController ..> GameRound : uses
    GameController ..> GameState : uses
    GameController ..> HandRank : uses
    GameController ..> PlayerStatus : uses


    %% Composition
    Deck "1" *-- "52" ICard : contains
    Table "1" *-- "0..5" ICard : contains
    GameController "1" *-- "*" IChip : contains
    GameController "1" *-- "1" IDeck : contains
    GameController "1" *-- "1" ITable : contains
    GameController "1" *-- "1..*" IPot : contains
    GameController "1" *-- "2..10" IPlayer : contains

    %% Relazation
    IChip <|.. Chip : implements
    ICard <|.. Card : implements
    IPlayer <|.. Player : implements
    IPot <|.. Pot : implements
    IDeck <|.. Deck : implements
    ITable <|.. Table : implements

    %% Enumeration
    class CardSuit {
        <<enumeration>>
        Spades
        Hearts
        Diamonds
        Clubs
    }

    class CardRank {
        <<enumeration>>
        Two = 2
        Three
        Four
        Five
        Six
        Seven
        Eight
        Nine
        Ten
        Jack = 11
        Queen = 12
        King = 13
        Ace = 14
    }

    class PlayerStatus {
        <<enumeration>>
        Active
        Folded
        AllIn
        Bust
    }

    class BettingAction {
        <<enumeration>>
        Fold
        Check
        Call
        Raise
        AllIn
    }

    class GameRound {
        <<enumeration>>
        PreFlop
        Flop
        Turn
        River
        Showdown
    }

    class GameState {
        <<enumeration>>
        WaitingForPlayers
        InProgress
        HandComplete
        GameOver
    }

    class HandRank {
        <<enumeration>>
        HighCard = 1
        OnePair
        TwoPair
        ThreeOfAKind
        Straight
        Flush
        FullHouse
        FourOfAKind
        StraightFlush
        RoyalFlush
    }

    %% Interface
    class IChip {
        <<Interface>>
        +int Amount
    }

    class ICard {
        <<Interface>>
        +CardSuit Suit
        +CardRank Rank
        +bool IsRevealed
        +ToString() : string
    }

    class IPlayer {
        <<Interface>>
        +string Name
        +PlayerStatus Status
    }

    class IPot {
        <<Interface>>
        +Dictionary~IPlayer, int~ Contributions
        +int TotalChips
    }

    class IDeck {
        <<Interface>>
        +List~ICard~ Cards
    }

    class ITable {
        <<Interface>>
        +List~ICard~ CommunityCards
    }

    %% Concrete Class
    class Chip {
        +int Amount
        +Chip(int amount)
    }

    class Card {
        +CardSuit Suit
        +CardRank Rank
        +bool IsRevealed
        +Card(CardSuit suit, CardRank rank)
        +ToString() string
    }

    class Player {
        +string Name
        +PlayerStatus Status
        +Player(string name)
    }

    class Pot {
        +Dictionary~IPlayer, int~ Contributions
        +int TotalChips
        +Pot()
    }

    class Deck {
        +List~ICard~ Cards
        +Deck()
    }

    class Table {
        +List~ICard~ CommunityCards
        +Table()
    }

    class GameController {
        %% Porperties / Field / State
        -Dictionary~IPlayer, List~IChip~~ _chips
        -Dictionary~IPlayer, List~ICard~~ _holeCards
        -Dictionary~IPlayer, int~ _currentBets
        -List~IPlayer~ _players
        -List~IPot~ _pots
        -IDeck _deck
        -ITable _table
        -int _dealerIndex
        -int _currentPlayerIndex
        -int _lastRaiserIndex
        -int _lastRaiseAmount
        -int _currentHighestBet
        -int _smallBlind
        -int _bigBlind
        -GameRound _currentRound
        -GameState _gameState

        %% Event Notification
        +Action~GameRound~ OnRoundChanged
        +Action~List~IPlayer~~ OnHandWinnersDecided

        %% Contructor
        +GameController(int smallBlind, int bigBlind)

        %% Lifecycle public
        +AddPlayer(string name, int chips) : void
        +StartGame() : void
        +StartNextHand() : void

        %% Get Info Game and Round
        +GetGameState() : GameState
        +GetCurrentRound() : GameRound
        +IsGameOver() : bool
        +GetGameWinner() : IPlayer
        +GetHandWinners() : List~IPlayer~

        %% Get Info Players
        +GetCurrentPlayer() : IPlayer
        +GetAllPlayers() : List~IPlayer~
        +GetDealer() : IPlayer
        +GetPlayerStatus(IPlayer player) : PlayerStatus
        +GetPlayerHoleCards(IPlayer player) : List~ICard~

        %% Get Info Chips and Betting
        +GetPlayerChips(IPlayer player) : List~IChip~
        +GetPlayerTotalChips(IPlayer player) : int
        +GetPlayerCurrentBet(IPlayer player) : int
        +GetSmallBlind() : int
        +GetBigBlind() : int
        +GetCurrentHighestBet() : int
        +GetCallAmount(IPlayer player) : int
        +GetMinRaise() : int
        +GetAvailableBettingAction(IPlayer player) : List~BettingAction~

        %% Get Info Cards and Pot
        +GetCommunityCards() : List~ICard~
        +GetMainPot() : IPot
        +GetSidePots() : List~IPot~
        +GetTotalPotAmount() : int

        %% Action Public
        +Fold(IPlayer player) : void
        +Check(IPlayer player) : void
        +Call(IPlayer player) : void
        +Raise(IPlayer player, int amount) : void
        +AllIn(IPlayer player) : void

        %% Logic Bisnis Hand Setup
        -StartNewHand() : void
        -ShuffleDeck() : void
        -RotateDealer() : void
        -PostBlinds() : void

        %% Logic Bisnis Dealing
        -DealHoleCards() : void
        -DealCard() : ICard
        -DealFlop() : void
        -DealTurn() : void
        -DealRiver() : void
        -RunShowdown() : void

        %% Logic Bisnis Betting Flow
        -RunBettingRound() : void
        -NextPlayer() : void
        -IsBettingRoundOver() : bool
        -ResolveIfOnePlayerLeft() : void

        %% Logic Bisnis Resolution
        -EvaluateHand(IPlayer player) : HandRank
        -CompareHands(List~IPlayer~ player) : List~IPlayer~
        -CreateSidePots() : void
        -AwardPot() : void
        -EliminateBustedPlayers() : void
    }

