classDiagram
    direction TB

    %% Dependency
    Card ..> CardSuit : uses
    Card ..> CardRank : uses
    Player ..> PlayerStatus : uses
    Pot ..> Player : uses
    GameController ..> BettingAction : uses
    GameController ..> GameRound : uses
    GameController ..> HandRank : uses


    %% Composition
    Deck "1" *-- "52" Card : contains
    Table "1" *-- "0..5" Card : contains
    GameController "1" *-- "1" Deck : contains
    GameController "1" *-- "1" Table : contains
    GameController "1" *-- "1" Pot : contains
    GameController "1" *-- "2..10" Player : contains

    %% Enumeration
    class CardSuit {
        <<enumeration>>
        Spades
        Hearts
        Diamonds
        Clubs
    }

    class CardRank {
        <<enumeration>>
        Two = 2
        Three
        Four
        Five
        Six
        Seven
        Eight
        Nine
        Ten
        Jack = 11
        Queen = 12
        King = 13
        Ace = 14
    }

    class PlayerStatus {
        <<enumeration>>
        Active
        Folded
        AllIn
        Bust
    }

    class BettingAction {
        <<enumeration>>
        Fold
        Check
        Call
        Raise
        AllIn
    }

    class GameRound {
        <<enumeration>>
        PreFlop
        Flop
        Turn
        River
        Showdown
    }

    class HandRank {
        <<enumeration>>
        HighCard = 1
        OnePair
        TwoPair
        ThreeOfAKind
        Straight
        Flush
        FullHouse
        FourOfAKind
        StraightFlush
        RoyalFlush
    }

    class Card {
        +CardSuit Suit
        +CardRank Rank
        +bool IsRevealed
        +ToString() string
    }

    class Player {
        +int Id
        +string Name
        +PlayerStatus Status
    }

    class Pot {
        +Dictionary~Player, int~ Contributions
        +int TotalChips
    }

    class Deck {
        +List~Card~ Cards
    }

    class Table {
        +List~Card~ CommunityCards
    }

    class GameController {
        -Dictionary~Player, List~Card~~ _hands
        -Dictionary~Player, int~ _chips
        -int _dealerIndex
        -int _smallBlind
        -int _bigBlind
        -GameRound _currentRound
        -Deck _deck
        -Table _table
        -Pot _pot
        -List~Player~ _players

        +Action~GameRound~ OnRoundChanged
        +Action~Player~ OnWinnerDecided

        +StartGame() : void
        +AddPlayer(string name, int chips) : void
        +Fold(Player player) : void
        +Check(Player player) : void
        +Call(Player player) : void
        +Raise(Player player, int amount) : void
        +AllIn(Player player) : void
        +GetPlayerChips(Player player) : int
        +GetPlayerHand(Player player) : List~Card~
        +GetCommunityCards() : List~Card~
        +GetPot() : Pot
        +GetCurrentRound() : GameRound
        +GetWinner() : Player

        -ShuffleDeck() : void
        -DealDeck() : Card
        -PostBlinds() : void
        -DealHoleCards() : void
        -DealFlop() : void
        -DealTurn() : void
        -DealRiver() : void
        -RunShowdown() : void
        -EvaluateHand(Player player) : HandRank
        -AwardPot(Player player) : void
        -RotateDealer() : void
    }

