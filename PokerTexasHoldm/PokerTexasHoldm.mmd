classDiagram
    direction TB

    %% Dependency
    ICard ..> CardSuit : uses
    ICard ..> CardRank : uses
    IPlayer ..> PlayerStatus : uses
    IPot ..> IPlayer : uses
    GameController ..> BettingAction : uses
    GameController ..> GameRound : uses
    GameController ..> HandRank : uses
    GameController ..> ICard : uses


    %% Composition
    Deck "1" *-- "52" ICard : contains
    Table "1" *-- "0..5" ICard : contains
    GameController "1" *-- "1" IDeck : contains
    GameController "1" *-- "1" ITable : contains
    GameController "1" *-- "1" IPot : contains
    GameController "1" *-- "2..10" IPlayer : contains
    GameController "1" *-- "*" IChip : contains

    %% Relazation
    IChip <|.. Chip : implements
    ICard <|.. Card : implements
    IPlayer <|.. Player : implements
    IPot <|.. Pot : implements
    IDeck <|.. Deck : implements
    ITable <|.. Table : implements

    %% Enumeration
    class CardSuit {
        <<enumeration>>
        Spades
        Hearts
        Diamonds
        Clubs
    }

    class CardRank {
        <<enumeration>>
        Two = 2
        Three
        Four
        Five
        Six
        Seven
        Eight
        Nine
        Ten
        Jack = 11
        Queen = 12
        King = 13
        Ace = 14
    }

    class PlayerStatus {
        <<enumeration>>
        Active
        Folded
        AllIn
        Bust
    }

    class BettingAction {
        <<enumeration>>
        Fold
        Check
        Call
        Raise
        AllIn
    }

    class GameRound {
        <<enumeration>>
        PreFlop
        Flop
        Turn
        River
        Showdown
    }

    class HandRank {
        <<enumeration>>
        HighCard = 1
        OnePair
        TwoPair
        ThreeOfAKind
        Straight
        Flush
        FullHouse
        FourOfAKind
        StraightFlush
        RoyalFlush
    }

    %% Interface
    class IChip {
        <<Interface>>
        +int Amount
    }

    class ICard {
        <<Interface>>
        +CardSuit Suit
        +CardRank Rank
        +bool IsRevealed
        +ToString() : string
    }

    class IPlayer {
        <<Interface>>
        +string Name
        +PlayerStatus Status
    }

    class IPot {
        <<Interface>>
        +Dictionary~IPlayer, int~ Contributions
        +int TotalChips
    }

    class IDeck {
        <<Interface>>
        +List~ICard~ Cards
    }

    class ITable {
        <<Interface>>
        +List~ICard~ CommunityCards
    }

    %% Concrete Class
    class Chip {
        +int Amount
        +Chip(int amount)
    }

    class Card {
        +CardSuit Suit
        +CardRank Rank
        +bool IsRevealed
        +Card(CardSuit suit, CardRank rank)
        +ToString() string
    }

    class Player {
        +string Name
        +PlayerStatus Status
        +Player(string name)
    }

    class Pot {
        +Dictionary~IPlayer, int~ Contributions
        +int TotalChips
        +Pot()
    }

    class Deck {
        +List~ICard~ Cards
        +Deck()
    }

    class Table {
        +List~ICard~ CommunityCards
        +Table()
    }

    class GameController {
        %% Porperties / Field
        -Dictionary~IPlayer, List~ICard~~ _hands
        -Dictionary~IPlayer, List~IChip~~ _chips
        -int _dealerIndex
        -int _smallBlind
        -int _bigBlind
        -GameRound _currentRound
        -IDeck _deck
        -ITable _table
        -IPot _pot
        -List~IPlayer~ _players

        %% Event Notification
        +Action~GameRound~ OnRoundChanged
        +Action~List~IPlayer~~ OnWinnerDecided

        %% API yang dipublish
        +StartGame() : void
        +AddPlayer(string name, int chips) : void
        +Fold(IPlayer player) : void
        +Check(IPlayer player) : void
        +Call(IPlayer player) : void
        +Raise(IPlayer player, int amount) : void
        +AllIn(IPlayer player) : void
        +GetPlayerChips(IPlayer player) : int
        +GetPlayerHand(IPlayer player) : List~ICard~
        +GetCommunityCards() : List~ICard~
        +GetPot() : IPot
        +GetCurrentRound() : GameRound
        +GetWinner() : List~IPlayer~

        %% Logic Bisnis
        -PostBlinds() : void
        -ShuffleDeck() : void
        -DealCard() : ICard
        -DealHoleCards() : void
        -DealFlop() : void
        -DealTurn() : void
        -DealRiver() : void
        -RunShowdown() : void
        -EvaluateHand(IPlayer player) : HandRank
        -AwardPot(List~IPlayer~ winner) : void
        -RotateDealer() : void
    }

